# ============================================================
# Backend Environment Variables (Render → set in Dashboard)
# Copy this file to .env and fill in real values locally.
# NEVER commit .env — it is gitignored.
# ============================================================

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production          # MUST be 'production' on Render
PORT=5500                    # Render overrides this dynamically; local default = 5500

# ── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# ── AI / LLM ─────────────────────────────────────────────────
GEMINI_API_KEY=...           # Google Gemini — used for LLM + embeddings
GROQ_API_KEY=...             # Groq — primary fast LLM (qwen/qwen3.8-27b)

# ── Voice / TTS ──────────────────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# ── Search ───────────────────────────────────────────────────
TAVILY_API_KEY=...           # Backend-only — NOT a frontend/Vite variable
GOOGLE_SEARCH_API_KEY=...
GOOGLE_SEARCH_CX=...

# ── Storage ──────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=...
IMAGEKIT_PRIVATE_KEY=...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-id>

# ── Auth / OAuth ─────────────────────────────────────────────
WEBHOOK_SECRET=...
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_JWT_SECRET=sb_secret_...

# ── Push Notifications ───────────────────────────────────────
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...

# ── CORS / Client ────────────────────────────────────────────
CLIENT_URL=https://the-placementgrid.vercel.app

# ============================================================
# Frontend Environment Variables (Vercel → set in Dashboard)
# Copy this file to .env and fill in real values locally.
# NEVER commit .env — it is gitignored.
# ============================================================

# Supabase Auth (public keys — safe to expose in frontend bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Socket.IO: direct connection to Render backend
# In development, leave this blank (Vite proxy handles /socket.io → localhost:5500)
# In production (Vercel), set to: https://the-placementgrid.onrender.com
VITE_SOCKET_URL=https://the-placementgrid.onrender.com
